{
  "name": "@filtertotemplate/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app that fills team-designed templates from uploaded documents with a Copilot SDK agent",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:web": "vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "playwright test",
    "template:build": "node scripts/build-sample-template.mts",
    "template:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-template.mts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.140",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "ai": "7.0.137",
    "angular-expressions": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "cn": "^0.4.0",
    "docx-preview": "^0.4.1",
    "docxtemplater": "^3.71.0",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "pizzip": "^3.3.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "20.1.3",
    "sonner": "2.0.8",
    "streamdown": "2.7.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "docx": "^9.10.0",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "lodash": "^4.18.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
